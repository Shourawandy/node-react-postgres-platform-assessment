# Stage 1== Builder
FROM node:18-alpine AS builder
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci
COPY backend/ ./

# Stage == Production Runner
FROM node:18-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY backend/package*.json ./
RUN npm ci --only=production && npm cache clean --force
COPY --from=builder /app ./
USER node
EXPOSE 5000
CMD ["node", "index.js"]
